# ─────────────────────────────────────────────
# Chatwoot AI Bot — Environment Configuration
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Server
PORT=8084

# ── Chatwoot ──────────────────────────────────
# Base URL of your Chatwoot instance
CHATWOOT_BASE_URL=https://chat.example.com

# Agent Bot API access token (Settings > Integrations > Agent Bots)
CHATWOOT_API_TOKEN=changeme

# Your Chatwoot account ID (visible in the URL: /app/accounts/<ID>)
CHATWOOT_ACCOUNT_ID=

# Agent Bot secret — copy the auto-generated value from:
# Chatwoot Settings > Integrations > Agent Bots > [Your Bot] > Secret
# This is NOT a user-defined secret; it is auto-generated by Chatwoot when you create the bot.
CHATWOOT_WEBHOOK_SECRET=changeme

# ── AI Provider ───────────────────────────────
# OpenAI-compatible API base URL
AI_BASE_URL=https://api.example.com/v1

# API key for your AI provider
AI_API_KEY=changeme

# Model to use
AI_MODEL=gpt-4o-mini

# Max tokens per reply
AI_MAX_TOKENS=512

# System prompt override (optional)
# SYSTEM_PROMPT=You are a helpful customer support assistant...

# ── Knowledgebase Sync ───────────────────────
# Base URL of your WHMCS site to crawl for KB articles
WHMCS_BASE_URL=https://example.com

# Set to false to disable auto-sync on startup
KB_SYNC_ENABLED=true

# Timeout in ms for each HTTP request during KB crawl
KB_SYNC_TIMEOUT_MS=15000

# Optional token to protect the POST /kb/sync manual trigger endpoint
# KB_SYNC_TOKEN=your_secret_token

# ── Conversation Memory ───────────────────────
# Number of previous conversation turns to send to the AI (per conversation)
MAX_HISTORY_TURNS=10
